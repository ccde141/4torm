# npm pack is a separate distribution boundary: .gitignore is not applied when
# this file exists. Keep new top-level paths out until explicitly reviewed.
**/node_modules/
**/dist/
**/.env
**/.env.*
**/*.local
**/*.log
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal
/*
!/.env.example
!/LICENSE
!/README.md
!/README.zh-CN.md
!/LINUX.md
!/REMOTE.md
!/.dockerignore
!/Dockerfile
!/compose.yaml
!/build/
!/data/
!/docs/
!/electron/
!/eslint.config.js
!/index.html
!/package-lock.json
!/package.json
!/public/
!/server/
!/scripts/
!/src/
!/tsconfig.app.json
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts

# Local review artifacts and generated docs never belong in an npm archive.
/scripts/*
!/scripts/install-guide-skill.mjs
!/scripts/install-guide-skill.test.mjs
!/scripts/linux/
/scripts/linux/*
!/scripts/linux/install.sh
!/scripts/linux/start.sh
!/scripts/linux/runtime.sh
!/scripts/linux/backend.sh
!/scripts/linux/container-entrypoint.mjs
/design/
/prototypes/
/_release/
/.workspace/
/dist/
/dist-ssr/
/server/dist/
/server/node_modules/
/server/unused/

# Keep browser-facing static assets reviewed as well; future drops are excluded.
/build/*
!/build/icon.ico
!/build/icon.png
/public/*
!/public/4TORM.png
!/public/favicon.svg
!/public/fonts/
/public/fonts/*
!/public/fonts/OFL.txt
!/public/fonts/orbitron.woff2

# Docs are also default-deny. VitePress sources and user-reviewed examples
# are explicit; a new draft under docs/ is not auto-packaged.
/docs/*
